# Copy to .env. Never commit credentials, organizer links, or downloaded data.
OPENAI_API_KEY=
# Explicitly choose a model available to your account with Responses structured output.
OPENAI_MODEL=
ORGANIZER_API_URL=
DATABASE_PATH=local_data/cqa.sqlite3
REQUEST_TIMEOUT_SECONDS=90
WORKER_CONCURRENCY=2
MAX_INPUT_CHARACTERS=180000
MAX_OUTPUT_TOKENS=16000
# Optional; use only a value supported by the selected model. Blank uses provider default.
REASONING_EFFORT=
# Optional USD / million tokens; all three fields are required for an estimate.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
COST_RATE_SOURCE=
# Paid requests are paused by default; saved results, previews and reviews stay available.
BUDGET_LIMIT_USD=0
BUDGET_OVERHEAD_USD=0.10
# Optional reviewed opening costs/coverage, including other databases and unknown usage.
# Default: local_data/budget_baseline.json. Never put credentials in the baseline.
BUDGET_BASELINE_PATH=
